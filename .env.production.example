# Copy this to `.env` on the production host (never commit the real one — it's
# already covered by .gitignore) and fill in real values. Docker Compose loads
# `.env` automatically from the same directory as docker-compose.prod.yml.
#
# Generate strong random values, e.g.: openssl rand -base64 24

KEYCLOAK_ADMIN_PASSWORD=change-me
POSTGRES_PASSWORD=change-me
RABBITMQ_PASSWORD=change-me
