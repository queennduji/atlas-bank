<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Shared core for every native AtlasBank client (AtlasBank.Maui now, AtlasBank.Wpf later):
    the Gateway API client, the OAuth2/PKCE flow against Keycloak, and the DTOs that mirror
    each service's wire contract. No MAUI/WinUI/WPF reference here on purpose — each UI
    project brings its own IOAuthBrowserLauncher and ITokenStore, so this stays a plain
    .NET library a mobile app and a desktop app can both reference as-is.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AtlasBank.Clients.Core</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
