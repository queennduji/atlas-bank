<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AtlasBank.Maui.ViewModels"
             x:Class="AtlasBank.Maui.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             Shell.NavBarIsVisible="False">

    <Grid>
        <!-- shown while CheckForExistingSessionAsync runs, so a returning user doesn't see
             the login form flash before landing on the dashboard -->
        <VerticalStackLayout IsVisible="{Binding IsRestoringSession}"
                             VerticalOptions="Center" HorizontalOptions="Center" Spacing="16">
            <ActivityIndicator IsRunning="{Binding IsRestoringSession}"
                                Color="{AppThemeBinding Light={StaticResource BrandLight}, Dark={StaticResource BrandDark}}" />
        </VerticalStackLayout>

        <ScrollView IsVisible="{Binding IsRestoringSession, Converter={StaticResource InverseBoolConverter}}">
            <VerticalStackLayout Padding="32" Spacing="28" VerticalOptions="Center" MaximumWidthRequest="440" HorizontalOptions="Center">

                <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 12" WidthRequest="48" HeightRequest="48"
                            BackgroundColor="{AppThemeBinding Light={StaticResource BrandLight}, Dark={StaticResource BrandDark}}"
                            HorizontalOptions="Center">
                        <Label Text="A" TextColor="{StaticResource White}" FontSize="22" FontAttributes="Bold"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Text="Atlas Bank" Style="{StaticResource TitleLabel}" HorizontalOptions="Center" />
                    <Label Text="Sign in to view your accounts" Style="{StaticResource MutedLabel}" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabel}"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullOrEmptyConverter}}"
                       HorizontalTextAlignment="Center" />

                <VerticalStackLayout Spacing="12">
                    <Button Text="Sign in with Atlas Bank"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding SignInCommand}"
                            IsEnabled="{Binding IsNotBusy}" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                       Color="{AppThemeBinding Light={StaticResource BrandLight}, Dark={StaticResource BrandDark}}" />
                    <Label Style="{StaticResource MutedLabel}" HorizontalTextAlignment="Center"
                           Text="Opens in your browser — Atlas Bank never sees your password." />
                </VerticalStackLayout>

                <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />

                <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                    <Label Text="New to Atlas Bank?" Style="{StaticResource MutedLabel}" VerticalOptions="Center" />
                    <Button Text="Create an account" Style="{StaticResource TextButton}" Command="{Binding GoToRegisterCommand}" />
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
