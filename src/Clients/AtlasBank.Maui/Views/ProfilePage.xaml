<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AtlasBank.Maui.ViewModels"
             x:Class="AtlasBank.Maui.Views.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             Title="Profile">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabel}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullOrEmptyConverter}}" />

            <Label Text="Saved." Style="{StaticResource MutedLabel}"
                   TextColor="{AppThemeBinding Light={StaticResource PositiveLight}, Dark={StaticResource PositiveDark}}"
                   IsVisible="{Binding ShowSavedConfirmation}" />

            <!-- Read-only summary -->
            <Border Style="{StaticResource CardBorder}" IsVisible="{Binding IsEditing, Converter={StaticResource InverseBoolConverter}}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding Customer.FullName}" Style="{StaticResource TitleLabel}" />
                    <Label Text="{Binding Customer.Email}" Style="{StaticResource MutedLabel}" />
                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
                    <Label Text="{Binding Customer.PhoneNumber}" Style="{StaticResource BodyLabel}" />
                    <Label Style="{StaticResource BodyLabel}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding Customer.Address.Street}" />
                                <Span Text=", " />
                                <Span Text="{Binding Customer.Address.City}" />
                                <Span Text=", " />
                                <Span Text="{Binding Customer.Address.State}" />
                                <Span Text=" " />
                                <Span Text="{Binding Customer.Address.ZipCode}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Button Text="Edit profile" Style="{StaticResource SecondaryButton}" Command="{Binding BeginEditCommand}" Margin="0,8,0,0" />
                </VerticalStackLayout>
            </Border>

            <!-- Edit form -->
            <VerticalStackLayout Spacing="14" IsVisible="{Binding IsEditing}">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="First name" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource FieldBorder}"><Entry Text="{Binding FirstName}" /></Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="Last name" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource FieldBorder}"><Entry Text="{Binding LastName}" /></Border>
                    </VerticalStackLayout>
                </Grid>
                <VerticalStackLayout Spacing="4">
                    <Label Text="Phone number" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource FieldBorder}"><Entry Text="{Binding PhoneNumber}" Keyboard="Telephone" /></Border>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="4">
                    <Label Text="Street" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource FieldBorder}"><Entry Text="{Binding Street}" /></Border>
                </VerticalStackLayout>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="City" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource FieldBorder}"><Entry Text="{Binding City}" /></Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="State" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource FieldBorder}"><Entry Text="{Binding State}" /></Border>
                    </VerticalStackLayout>
                </Grid>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="ZIP code" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource FieldBorder}"><Entry Text="{Binding ZipCode}" Keyboard="Numeric" /></Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="Country" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource FieldBorder}"><Entry Text="{Binding Country}" /></Border>
                    </VerticalStackLayout>
                </Grid>
                <HorizontalStackLayout Spacing="12">
                    <Button Text="Save" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" WidthRequest="140" />
                    <Button Text="Cancel" Style="{StaticResource TextButton}" Command="{Binding CancelEditCommand}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                               Color="{AppThemeBinding Light={StaticResource BrandLight}, Dark={StaticResource BrandDark}}" />

            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" Margin="0,8" />
            <Button Text="Sign out" Style="{StaticResource DestructiveTextButton}" Command="{Binding SignOutCommand}" HorizontalOptions="Start" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
