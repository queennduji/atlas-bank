<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:AtlasBank.Maui"
             xmlns:conv="clr-namespace:AtlasBank.Maui.Converters"
             x:Class="AtlasBank.Maui.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:StatusToColorConverter x:Key="StatusToColorConverter" />
            <conv:MoneyMultiConverter x:Key="MoneyMultiConverter" />
            <conv:InverseBoolConverter x:Key="InverseBoolConverter" />
            <conv:IsNotNullOrEmptyConverter x:Key="IsNotNullOrEmptyConverter" />
            <conv:EnumEqualsConverter x:Key="EnumEqualsConverter" />
            <conv:IsNotNullConverter x:Key="IsNotNullConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
