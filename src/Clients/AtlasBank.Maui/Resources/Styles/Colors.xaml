<?xml version="1.0" encoding="UTF-8" ?>
<!-- Same palette as frontend/src/index.css, so the MAUI app and the web app read as the
     same product rather than two different color schemes bolted together. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Brand -->
    <Color x:Key="BrandLight">#0F6B5C</Color>
    <Color x:Key="BrandDark">#2FD8AE</Color>
    <Color x:Key="BrandSoftLight">#E4F3EF</Color>
    <Color x:Key="BrandSoftDark">#103029</Color>

    <!-- Surfaces -->
    <Color x:Key="BackgroundLight">#F6F7F9</Color>
    <Color x:Key="BackgroundDark">#0B0F14</Color>
    <Color x:Key="SurfaceLight">#FFFFFF</Color>
    <Color x:Key="SurfaceDark">#11161D</Color>
    <Color x:Key="SurfaceRaisedLight">#FFFFFF</Color>
    <Color x:Key="SurfaceRaisedDark">#161C25</Color>
    <Color x:Key="BorderLight">#E4E7EC</Color>
    <Color x:Key="BorderDark">#232A35</Color>

    <!-- Text -->
    <Color x:Key="TextLight">#10151F</Color>
    <Color x:Key="TextDark">#EEF1F5</Color>
    <Color x:Key="TextMutedLight">#5B6472</Color>
    <Color x:Key="TextMutedDark">#98A2B3</Color>
    <Color x:Key="TextFaintLight">#8A93A1</Color>
    <Color x:Key="TextFaintDark">#667082</Color>

    <!-- Status tones (also used by Converters/StatusToColorConverter.cs) -->
    <Color x:Key="PositiveLight">#0F8A5F</Color>
    <Color x:Key="PositiveDark">#2FD8AE</Color>
    <Color x:Key="NegativeLight">#D1373F</Color>
    <Color x:Key="NegativeDark">#F26D75</Color>
    <Color x:Key="WarningLight">#B5790A</Color>
    <Color x:Key="WarningDark">#E3AC4C</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Transparent">Transparent</Color>

</ResourceDictionary>
