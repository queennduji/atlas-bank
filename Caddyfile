# Reverse proxy for the three public domains. Caddy handles HTTPS automatically
# (Let's Encrypt) for each — no manual certificate management needed.
#
# Everything behind these three entries stays on the internal Docker network;
# nothing else (Postgres, RabbitMQ, Seq, the individual services) is published
# to the host at all in production — only Caddy is.
#
# HTTP/3 disabled: Caddy defaults to advertising it via `Alt-Svc`, which runs
# over UDP 443. The VM's iptables only allows TCP on 80/443 (UDP 443 is hard
# REJECTed), so browsers attempting the QUIC upgrade got a black hole instead
# of a clean refusal — surfacing as intermittent ERR_SSL_PROTOCOL_ERROR before
# falling back to plain HTTP/2 over TCP. Disabling h3 removes the failure mode
# entirely instead of opening a second firewall (VM iptables + OCI Security
# List) just to support a protocol this site doesn't need.
{
	servers {
		protocols h1 h2
	}
}

atlasbank.dev {
	reverse_proxy frontend:80
}

api.atlasbank.dev {
	reverse_proxy api-gateway:8080
}

auth.atlasbank.dev {
	reverse_proxy keycloak:8080
}
